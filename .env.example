# ============================================
# GearUp Backend — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your values.
# See README.md for detailed descriptions of each variable.

# ── Database ──────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/gearup?schema=public"

# ── App Configuration ─────────────────────────
PORT=5000
APP_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
CANCEL_URL="http://localhost:3000"

# ── Authentication ────────────────────────────
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET="your_access_token_secret"
JWT_REFRESH_SECRET="your_refresh_token_secret"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Google Sign-In (optional)
# Create an OAuth 2.0 Web Client ID in Google Cloud Console and add
# http://localhost:3000 to its authorised JavaScript origins.
# Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=""

# ── Stripe Payment Gateway ────────────────────
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_PRODUCT_PRICE_ID="price_placeholder"