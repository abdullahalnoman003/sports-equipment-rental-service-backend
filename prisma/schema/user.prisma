model user {
    id        String       @id @default(uuid())
    name      String
    email     String       @unique
    /// Optional so accounts created through Google sign-in have no local password.
    password  String?
    role      Role         @default(CUSTOMER)
    /// LOCAL for email + password accounts, GOOGLE for OAuth accounts.
    authProvider AuthProvider @default(LOCAL)
    createdAt DateTime     @default(now())
    updatedAt DateTime     @updatedAt
    status    Status       @default(ACTIVE)

    profile profile?
    rentals  rental[]
    gears   gear[]
    reviews review[]

    @@map("Users")
}

enum Status {
    ACTIVE
    INACTIVE
    SUSPENDED
}

enum Role {
    CUSTOMER
    PROVIDER
    ADMIN
}

enum AuthProvider {
    LOCAL
    GOOGLE
}
